detect_resources() {
  local requested_mode="${1:-auto}"
  local gpu_probe_policy="${2:-pull}"
  load_env
  hardware_detect_host "${AI_STACK_HOME}"
  hardware_detect_nvidia_host
  DETECTED_DISK_FREE_GB="${DETECTED_RUNTIME_DISK_FREE_GB:-0}"
  DETECTED_GPU_USABLE="false"
  if [[ "${DETECTED_GPU_NAME}" != "none" && "${requested_mode}" != "cpu" ]]; then
    if [[ "${gpu_probe_policy}" == "cached" ]] && ! docker image inspect ubuntu:24.04 >/dev/null 2>&1; then
      DETECTED_CONTAINER_GPU="not tested (probe image is not cached)"
    elif hardware_probe_container_gpu "$( [[ "${gpu_probe_policy}" == "cached" ]] && printf 'never' || printf 'missing' )"; then
      DETECTED_GPU_USABLE="true"
    fi
  fi
}

recommend_model() {
  if (( DETECTED_RAM_GB < 12 )); then
    RECOMMENDED_MODEL_CHOICE="1"
  elif (( DETECTED_RAM_GB < 32 )); then
    RECOMMENDED_MODEL_CHOICE="2"
  elif [[ -n "$(model_url_for_choice 3)" || -f "${AI_STACK_HOME}/models/$(model_file_for_choice 3)" ]]; then
    RECOMMENDED_MODEL_CHOICE="3"
  else
    RECOMMENDED_MODEL_CHOICE="2"
  fi
}

print_detected_resources() {
  printf 'OS: %s (%s)\n' "${DETECTED_OS_DESCRIPTION}" "${DETECTED_ARCH}"
  printf 'CPU: %s cores\n' "${DETECTED_CPU_CORES}"
  printf 'RAM: %s GiB total, %s GiB available\n' "${DETECTED_RAM_GB}" "${DETECTED_AVAILABLE_RAM_GB}"
  printf 'Runtime storage: %s GiB free at %s\n' "${DETECTED_RUNTIME_DISK_FREE_GB}" "${DETECTED_RUNTIME_PATH}"
  printf 'Container storage: %s GiB free at %s\n' "${DETECTED_DOCKER_DISK_FREE_GB}" "${DETECTED_DOCKER_ROOT}"
  printf 'Container engine: %s\n' "${DETECTED_CONTAINER_ENGINE_VERSION}"
  if [[ "${DETECTED_GPU_NAME}" == "none" ]]; then
    printf 'GPU: none detected\n'
  else
    printf 'GPU: %s, %s GiB VRAM\n' "${DETECTED_GPU_NAME}" "${DETECTED_GPU_VRAM_GB}"
    printf 'NVIDIA driver: %s (CUDA compatibility %s)\n' "${DETECTED_NVIDIA_DRIVER}" "${DETECTED_CUDA_COMPATIBILITY}"
    printf 'NVIDIA runtime: %s; container GPU: %s\n' "${DETECTED_NVIDIA_RUNTIME}" "${DETECTED_CONTAINER_GPU}"
  fi
}

resolve_compute_selection() {
  local requested="$1"
  if ! compute_resolve \
      "${requested}" \
      "${DETECTED_GPU_USABLE}" \
      "${DETECTED_CUDA_COMPATIBILITY}" \
      "${DETECTED_OS}" \
      "${DETECTED_ARCH}" \
      "${DETECTED_CONTAINER_ENGINE}"; then
    fail "${COMPUTE_RESOLUTION_REASON}. Run ./ai-stack hardware and see docs/setup/gpu-installation.md"
  fi
  SELECTED_COMPUTE_MODE="${requested}"
  SELECTED_PYTORCH_BACKEND="${COMPUTE_RESOLVED_BACKEND}"
  SELECTED_EMBEDDING_DEVICE="${COMPUTE_RESOLVED_DEVICE}"
}

prompt_yes_no() {
  local prompt="$1"
  local answer
  read -r -p "${prompt}" answer || return 1
  case "${answer}" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_model_selection() {
  local choice selected_name
  printf 'Recommended model: %s\n' "$(model_name_for_choice "${RECOMMENDED_MODEL_CHOICE}")"

  while true; do
    cat <<EOF

Choose model to install:

[1] ${DEFAULT_MODEL_NAME}
    $(model_description_for_choice 1)

[2] ${MODEL_7B_NAME}
    $(model_description_for_choice 2)

[3] ${VM60_MODEL_NAME}
    $(model_description_for_choice 3)

[4] Add your own GGUF model
    $(model_description_for_choice 4)

EOF
    read -r -p "Enter choice [recommended: ${RECOMMENDED_MODEL_CHOICE}]: " choice || {
      info "install cancelled"
      exit 0
    }
    choice="${choice:-${RECOMMENDED_MODEL_CHOICE}}"
    case "${choice}" in
      1|2|3|4)
        if [[ "${choice}" == "3" && "${DETECTED_RAM_GB}" -lt 32 ]]; then
          warn "Qwen3.6-35B may exceed your available resources and may be slow or unstable."
          if ! prompt_yes_no "Continue anyway? [y/N]: "; then
            continue
          fi
        fi
        if [[ "${choice}" == "3" ]]; then
          prompt_install_model_details preset-vm60
        elif [[ "${choice}" == "4" ]]; then
          prompt_install_model_details custom
        fi
        SELECTED_MODEL_CHOICE="${choice}"
        selected_name="$(model_name_for_choice "${choice}")"
        info "selected model: ${selected_name}"
        return
        ;;
      *)
        warn "invalid choice: ${choice}"
        ;;
    esac
  done
}

prompt_install_model_details() {
  local mode="$1"
  local answer derived_file

  SELECTED_MODEL_SHA256=""
  SELECTED_MODEL_EXPECTED_SIZE_GB=""

  if [[ "${mode}" == "preset-vm60" ]]; then
    SELECTED_MODEL_NAME="${VM60_MODEL_NAME}"
    SELECTED_MODEL_FILE="${VM60_MODEL_FILE}"
    SELECTED_MODEL_PROFILE="vm60"
    printf '\n%s requires a direct GGUF download URL.\n' "${VM60_MODEL_NAME}"
  else
    read -r -p "Model name (for example, Qwen3-8B-Q4_K_M): " SELECTED_MODEL_NAME || fail "install cancelled"
  fi

  read -r -p "Direct GGUF download URL: " SELECTED_MODEL_URL || fail "install cancelled"

  if [[ "${mode}" == "custom" ]]; then
    derived_file="$(model_file_from_url "${SELECTED_MODEL_URL}")"
    read -r -p "Local filename [${derived_file}]: " answer || fail "install cancelled"
    SELECTED_MODEL_FILE="${answer:-${derived_file}}"
    read -r -p "Runtime profile: laptop, vm16, or vm60 [vm16]: " answer || fail "install cancelled"
    SELECTED_MODEL_PROFILE="${answer:-vm16}"
  fi

  read -r -p "Expected size in GiB (optional if URL size can be detected): " SELECTED_MODEL_EXPECTED_SIZE_GB || fail "install cancelled"
  read -r -p "SHA-256 checksum (optional): " SELECTED_MODEL_SHA256 || fail "install cancelled"

  validate_model_add_values \
    "${SELECTED_MODEL_NAME}" \
    "${SELECTED_MODEL_URL}" \
    "${SELECTED_MODEL_FILE}" \
    "${SELECTED_MODEL_PROFILE}" \
    "${SELECTED_MODEL_EXPECTED_SIZE_GB}" \
    "${SELECTED_MODEL_SHA256}"
}

backup_env() {
