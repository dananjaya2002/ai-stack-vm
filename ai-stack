cmd_profile() {
  local profile="${1:-}"
  [[ -n "${profile}" ]] || fail "usage: ./ai-stack profile laptop|vm16|vm60"
  cmd_init

  case "${profile}" in
    laptop)
      set_env_var MODEL_NAME "${DEFAULT_MODEL_NAME}"
      set_env_var MODEL_FILE "${DEFAULT_MODEL_FILE}"
      set_env_var MODEL_PROFILE "laptop"
      set_env_var MODEL_URL "${DEFAULT_MODEL_URL}"
      set_env_var MODEL_SHA256 ""
