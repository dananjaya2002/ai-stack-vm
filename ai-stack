cmd_compute_runtime_verify() {
  local scope="$1"
  local service="$2"
  local expected_backend expected_device script
  load_env
  expected_backend="${PYTORCH_BACKEND}"
  expected_device="${EMBEDDING_DEVICE}"
  script='import os, torch
from ai_stack_rag.embeddings.provider import EmbeddingProvider
backend = os.environ["PYTORCH_BACKEND_EXPECTED"]
device = os.environ["EMBEDDING_DEVICE_EXPECTED"]
is_gpu = backend != "cpu"
assert (torch.version.cuda is not None) == is_gpu, (backend, torch.version.cuda)
assert torch.cuda.is_available() == is_gpu, torch.cuda.is_available()
assert os.environ.get("EMBEDDING_DEVICE", "cpu") == device
provider = EmbeddingProvider(os.environ.get("EMBED_MODEL_NAME", "all-MiniLM-L6-v2"), device)
dimension = provider.dimension()
assert dimension > 0
gpu_name = torch.cuda.get_device_name(0) if is_gpu else "none"
print(f"PyTorch={torch.__version__} backend={backend} cuda={torch.version.cuda} available={torch.cuda.is_available()} device={gpu_name} embedding_dimension={dimension}")'
  compose_scope "${scope}" exec -T \
    -e "PYTORCH_BACKEND_EXPECTED=${expected_backend}" \
    -e "EMBEDDING_DEVICE_EXPECTED=${expected_device}" \
    "${service}" python -c "${script}"
}

cmd_compute_runtime_verify_with_retry() {
  local scope="$1"
  local service="$2"
  local attempt
  for attempt in 1 2 3 4 5 6; do
    if cmd_compute_runtime_verify "${scope}" "${service}"; then
      return 0
    fi
    (( attempt < 6 )) && sleep 5
  done
  fail "runtime compute verification failed for ${service}"
}

