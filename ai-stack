}

info() {
  printf '[ai-stack] %s\n' "$*"
}

warn() {
  printf '[ai-stack] warning: %s\n' "$*" >&2
}

fail() {
  printf '[ai-stack] error: %s\n' "$*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

compose() {
  if have docker && docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif have docker-compose; then
    docker-compose "$@"
  elif have podman && podman compose version >/dev/null 2>&1; then
    podman compose "$@"
  elif have podman-compose; then
    podman-compose "$@"
  else
    fail "Compose was not found. Install Docker Compose, podman-compose, or a Podman version with 'podman compose'."
  fi
}

compose_available() {
  if have docker && docker compose version >/dev/null 2>&1; then
    return 0
  elif have docker-compose; then
    return 0
  elif have podman && podman compose version >/dev/null 2>&1; then
    return 0
  elif have podman-compose; then
    return 0
  fi
  return 1
}

load_env() {
  local model_url_was_set=0
  if [[ -f "${ENV_FILE}" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "${ENV_FILE}"
    set +a
    if [[ ${MODEL_URL+x} ]]; then
      model_url_was_set=1
    fi
  fi

  AI_STACK_HOME="${AI_STACK_HOME:-${HOME}/ai-stack}"
  MODEL_NAME="${MODEL_NAME:-${DEFAULT_MODEL_NAME}}"
  MODEL_FILE="${MODEL_FILE:-${DEFAULT_MODEL_FILE}}"
  MODEL_PROFILE="${MODEL_PROFILE:-laptop}"
  if (( model_url_was_set == 0 )); then
    MODEL_URL="${DEFAULT_MODEL_URL}"
  else
    MODEL_URL="${MODEL_URL:-}"
  fi
  MODEL_SHA256="${MODEL_SHA256:-}"
  LLAMA_THREADS="${LLAMA_THREADS:-6}"
  LLAMA_CONTEXT="${LLAMA_CONTEXT:-8192}"
  LLAMA_BATCH="${LLAMA_BATCH:-512}"
  LLAMA_UBATCH="${LLAMA_UBATCH:-256}"
  SECURITY_MODE="${SECURITY_MODE:-development}"
  AI_STACK_API_KEY="${AI_STACK_API_KEY:-}"
  BIND_HOST="${BIND_HOST:-127.0.0.1}"
  OPEN_WEBUI_BIND_HOST="${OPEN_WEBUI_BIND_HOST:-0.0.0.0}"
  DASHBOARD_BIND_HOST="${DASHBOARD_BIND_HOST:-0.0.0.0}"
  DASHBOARD_AUTH_MODE="${DASHBOARD_AUTH_MODE:-auto}"
  DASHBOARD_ADMIN_USERNAME="${DASHBOARD_ADMIN_USERNAME:-admin}"
  DASHBOARD_ADMIN_PASSWORD_HASH="${DASHBOARD_ADMIN_PASSWORD_HASH:-}"
  DASHBOARD_SESSION_SECRET="${DASHBOARD_SESSION_SECRET:-}"
  ENABLE_RATE_LIMIT="${ENABLE_RATE_LIMIT:-true}"
  RATE_LIMIT_PER_MINUTE="${RATE_LIMIT_PER_MINUTE:-60}"
  QDRANT_HOST="${QDRANT_HOST:-qdrant}"
  QDRANT_PORT="${QDRANT_PORT:-6333}"
  MEMORY_COLLECTION="${MEMORY_COLLECTION:-engineering-memory}"
  CODE_COLLECTION="${CODE_COLLECTION:-code-memory}"
  LLM_BASE_URL="${LLM_BASE_URL:-http://vm-llama:8082/v1}"
  EMBED_MODEL_NAME="${EMBED_MODEL_NAME:-all-MiniLM-L6-v2}"
  HF_TOKEN="${HF_TOKEN:-}"
  MEMORY_API_LOGS="${MEMORY_API_LOGS:-true}"
  MEMORY_API_LOG_FILE="${MEMORY_API_LOG_FILE:-/logs/memory/memory_api.log}"
  MEMORY_TOP_K="${MEMORY_TOP_K:-5}"
  MEMORY_SCORE_THRESHOLD="${MEMORY_SCORE_THRESHOLD:-0.5}"
  CODE_PROXY_LOGS="${CODE_PROXY_LOGS:-true}"
  CODE_PROXY_LOG_FILE="${CODE_PROXY_LOG_FILE:-/logs/code/code_proxy.log}"
  CODE_TOP_K="${CODE_TOP_K:-8}"
  SEARCH_LIMIT_MULTIPLIER="${SEARCH_LIMIT_MULTIPLIER:-4}"
  CODE_SCORE_THRESHOLD="${CODE_SCORE_THRESHOLD:-0.25}"
  MAX_CHUNKS_PER_FILE="${MAX_CHUNKS_PER_FILE:-2}"
  MAX_TEXT_PREVIEW_CHARS="${MAX_TEXT_PREVIEW_CHARS:-1200}"
  MAX_CHUNK_CHARS="${MAX_CHUNK_CHARS:-4000}"
  MAX_CONTEXT_CHARS="${MAX_CONTEXT_CHARS:-50000}"
  AGENTIC_RAG_LOGS="${AGENTIC_RAG_LOGS:-true}"
  AGENTIC_RAG_LOG_FILE="${AGENTIC_RAG_LOG_FILE:-/logs/agentic-rag/agentic_rag.log}"
  ENABLE_INDEX_V2="${ENABLE_INDEX_V2:-true}"
  ENABLE_AGENTIC_RETRIEVAL="${ENABLE_AGENTIC_RETRIEVAL:-true}"
