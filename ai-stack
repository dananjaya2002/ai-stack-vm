  AGENTIC_INITIAL_SUBQUERIES="${AGENTIC_INITIAL_SUBQUERIES:-3}"
  AGENTIC_FOLLOWUP_TOP_K="${AGENTIC_FOLLOWUP_TOP_K:-4}"
