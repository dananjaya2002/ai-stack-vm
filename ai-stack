cmd_model_download() {
  local url="${1:-}"
  local dir file dest
  cmd_init
  load_env

  if [[ -z "${url}" ]]; then
    url="${MODEL_URL}"
  fi
  [[ -n "${url}" ]] || fail "set MODEL_URL in .env or run: ./ai-stack model download <url>"
  have curl || fail "curl is required to download models"

  dir="${AI_STACK_HOME}/models"
  mkdir -p "${dir}"

  file="${MODEL_FILE}"
  if [[ "${file}" == "${DEFAULT_MODEL_FILE}" && "${url}" == *".gguf"* ]]; then
    file="$(basename "${url%%\?*}")"
    set_env_var MODEL_FILE "${file}"
  fi

  if [[ "${MODEL_URL}" != "${url}" ]]; then
    set_env_var MODEL_URL "${url}"
  fi

  dest="${dir}/${file}"
  info "downloading model to ${dest}"
  curl --fail --location --continue-at - --output "${dest}" "${url}"

  load_env
  if [[ -n "${MODEL_SHA256}" ]]; then
    printf '%s  %s\n' "${MODEL_SHA256}" "${dest}" | sha256sum -c -
  fi
  info "model ready: ${dest}"
}

