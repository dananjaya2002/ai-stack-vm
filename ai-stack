validate_model_add_values() {
  local name="$1" url="$2" file="$3" profile="$4" size_gb="$5" sha256="$6"
  local safe_url_pattern='^https?://[A-Za-z0-9./_~:%?=,+@!-]+$'

  [[ "${name}" =~ ^[A-Za-z0-9][A-Za-z0-9._:/+-]*$ ]] || \
    fail "model name may contain only letters, numbers, dot, underscore, colon, slash, plus, and hyphen"
  [[ "${url}" =~ ${safe_url_pattern} ]] || \
    fail "model URL contains characters that cannot be stored safely in .env; use a direct URL with encoded query values"
  [[ "${file}" == "$(basename "${file}")" ]] || fail "model filename must not contain a directory"
  [[ "${file}" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*\.gguf$ ]] || \
    fail "model filename must end in .gguf and contain only safe filename characters"
  case "${profile}" in laptop|vm16|vm60) ;; *) fail "model profile must be laptop, vm16, or vm60" ;; esac
  [[ -z "${size_gb}" || "${size_gb}" =~ ^[1-9][0-9]*$ ]] || fail "--size-gb must be a positive whole number"
  [[ -z "${sha256}" || "${sha256}" =~ ^[A-Fa-f0-9]{64}$ ]] || fail "--sha256 must contain exactly 64 hexadecimal characters"
}

download_model_file() {
  local url="$1" dest="$2" sha256="${3:-}"
  local curl_args=(--fail --location --continue-at - --output "${dest}")

  have curl || fail "curl is required to download models"
  if [[ -n "${HF_TOKEN:-}" ]]; then
    curl_args+=(-H "Authorization: Bearer ${HF_TOKEN}")
  fi

  info "downloading model to ${dest}"
  curl "${curl_args[@]}" "${url}"

  if [[ -n "${sha256}" ]]; then
    have sha256sum || fail "sha256sum is required when a checksum is provided"
    printf '%s  %s\n' "${sha256}" "${dest}" | sha256sum -c -
  fi
  info "model ready: ${dest}"
}

cmd_model_add() {
  local name="" url="" file="" profile="" size_gb="" sha256="" assume_yes=0
  local answer current_profile dest

  while (( $# > 0 )); do
    case "$1" in
      --name|--url|--file|--profile|--size-gb|--sha256)
        (( $# >= 2 )) || fail "$1 requires a value"
        case "$1" in
          --name) name="$2" ;;
          --url) url="$2" ;;
          --file) file="$2" ;;
          --profile) profile="$2" ;;
          --size-gb) size_gb="$2" ;;
          --sha256) sha256="$2" ;;
        esac
        shift 2
        ;;
      -y|--yes) assume_yes=1; shift ;;
      -h|--help) model_add_usage; return 0 ;;
      *) fail "unknown model add option: $1 (run ./ai-stack model add --help)" ;;
    esac
  done

  cmd_init
  load_env
  current_profile="${MODEL_PROFILE}"

  if [[ -z "${name}" ]]; then
    read -r -p "Model name (for example, Qwen3-8B-Q4_K_M): " name || fail "model add cancelled"
  fi
  if [[ -z "${url}" ]]; then
    read -r -p "Direct GGUF download URL: " url || fail "model add cancelled"
  fi
  if [[ -z "${file}" ]]; then
    file="$(model_file_from_url "${url}")"
    if (( assume_yes == 0 )); then
      read -r -p "Local filename [${file}]: " answer || fail "model add cancelled"
      file="${answer:-${file}}"
    fi
  fi
  if [[ -z "${profile}" ]]; then
    if (( assume_yes == 0 )); then
      read -r -p "Runtime profile: laptop, vm16, or vm60 [${current_profile}]: " answer || fail "model add cancelled"
      profile="${answer:-${current_profile}}"
    else
      profile="${current_profile}"
    fi
  fi
  if [[ -z "${size_gb}" && ${assume_yes} -eq 0 ]]; then
    read -r -p "Expected size in GiB (optional): " size_gb || fail "model add cancelled"
  fi
  if [[ -z "${sha256}" && ${assume_yes} -eq 0 ]]; then
    read -r -p "SHA-256 checksum (optional): " sha256 || fail "model add cancelled"
  fi

  validate_model_add_values "${name}" "${url}" "${file}" "${profile}" "${size_gb}" "${sha256}"
  dest="${AI_STACK_HOME}/models/${file}"

  printf '\nModel:   %s\nFile:    %s\nProfile: %s\nSource:  %s\n' "${name}" "${dest}" "${profile}" "${url}"
  if (( assume_yes == 0 )) && ! prompt_yes_no "Download and activate this model? [y/N]: "; then
    info "model add cancelled"
    return 0
  fi

  mkdir -p "${AI_STACK_HOME}/models"
  download_model_file "${url}" "${dest}" "${sha256}"

  set_env_var MODEL_NAME "${name}"
  set_env_var MODEL_FILE "${file}"
  set_env_var MODEL_PROFILE "${profile}"
  set_env_var MODEL_URL "${url}"
  set_env_var MODEL_SHA256 "${sha256}"
  set_env_var MODEL_EXPECTED_SIZE_GB "${size_gb}"
  apply_model_profile_settings "${profile}"

  info "installed and activated ${name}"
  info "run ./ai-stack apply-config to load it into a running stack"
}

cmd_model_download() {
  local url="${1:-}"
  local dir file dest
  cmd_init
  load_env

  if [[ -z "${url}" ]]; then
    url="${MODEL_URL}"
  fi
  [[ -n "${url}" ]] || fail "set MODEL_URL in .env or run: ./ai-stack model download <url>"
  have curl || fail "curl is required to download models"

  dir="${AI_STACK_HOME}/models"
  mkdir -p "${dir}"

  file="${MODEL_FILE}"
  if [[ "${file}" == "${DEFAULT_MODEL_FILE}" && "${url}" == *".gguf"* ]]; then
    file="$(basename "${url%%\?*}")"
    set_env_var MODEL_FILE "${file}"
  fi

  if [[ "${MODEL_URL}" != "${url}" ]]; then
    set_env_var MODEL_URL "${url}"
  fi

  dest="${dir}/${file}"
  download_model_file "${url}" "${dest}" "${MODEL_SHA256}"
}

