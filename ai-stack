set_env_var() {
  local key="$1"
  local value="$2"
  if [[ -f "${ENV_FILE}" ]] && grep -Fxq "${key}=${value}" "${ENV_FILE}"; then
    return 0
  fi
  [[ -f "${ENV_FILE}" ]] && backup_env
  env_set_var "${ENV_FILE}" "${key}" "${value}"
}

cpu_count() {
  if have nproc; then
    nproc
  else
    getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'
  fi
}

memory_gb() {
  if [[ -r /proc/meminfo ]]; then
    awk '/MemTotal/ { printf "%.0f", $2 / 1024 / 1024 }' /proc/meminfo
  else
    printf '0'
  fi
}

default_threads() {
  local cpus="$1"
  local threads
  threads=$((cpus - 6))
  if (( threads < 1 )); then
    threads=1
  fi
  if (( threads > 54 )); then
    threads=54
  fi
  printf '%s' "${threads}"
}

default_memory_limit() {
  local mem="$1"
  if (( mem >= 36 )); then
    printf '30gb'
  elif (( mem >= 24 )); then
    printf '18gb'
  else
    printf '12gb'
  fi
}

default_memory_reservation() {
  local mem="$1"
  if (( mem >= 36 )); then
    printf '16gb'
  elif (( mem >= 24 )); then
    printf '10gb'
  else
    printf '6gb'
  fi
}

port_status() {
  local port="$1"
  if have ss; then
    if ss -ltn "( sport = :${port} )" | grep -q ":${port}"; then
      printf 'busy'
    else
      printf 'free'
    fi
  elif have lsof; then
    if lsof -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
      printf 'busy'
    else
      printf 'free'
    fi
  else
    printf 'unknown'
  fi
}

cmd_doctor() {
  load_env
  local failures=0 resolution="ready"
  detect_resources "${COMPUTE_MODE}" cached

  printf 'AI Stack VM Doctor\n==================\n\nHost\n'
  printf '  OS                 %s\n' "${DETECTED_OS_DESCRIPTION}"
  printf '  Architecture       %s\n' "${DETECTED_ARCH}"
  printf '  CPU                %s cores\n' "${DETECTED_CPU_CORES}"
  printf '  RAM                %s GiB total / %s GiB available\n' "${DETECTED_RAM_GB}" "${DETECTED_AVAILABLE_RAM_GB}"
  printf '  Runtime disk       %s GiB free\n' "${DETECTED_RUNTIME_DISK_FREE_GB}"
  printf '  Container disk     %s GiB free\n' "${DETECTED_DOCKER_DISK_FREE_GB}"

  printf '\nPrerequisites\n'
  local bin
  for bin in git curl awk; do
    if have "${bin}"; then
      printf '  %-18s OK\n' "${bin}"
    else
      printf '  %-18s MISSING\n' "${bin}"
      failures=$((failures + 1))
    fi
  done
  if [[ -n "${DETECTED_CONTAINER_ENGINE}" ]]; then
    printf '  Container engine   OK (%s)\n' "${DETECTED_CONTAINER_ENGINE}"
  else
    printf '  Container engine   MISSING\n'
    failures=$((failures + 1))
  fi
  if compose_available; then
    printf '  Compose             OK\n'
  else
    printf '  Compose             MISSING\n'
    failures=$((failures + 1))
  fi

  printf '\nGPU\n'
  printf '  NVIDIA GPU         %s\n' "${DETECTED_GPU_NAME}"
  printf '  nvidia-smi         %s\n' "${DETECTED_NVIDIA_SMI}"
  printf '  Driver             %s\n' "${DETECTED_NVIDIA_DRIVER}"
  printf '  CUDA compatibility %s\n' "${DETECTED_CUDA_COMPATIBILITY}"
  printf '  Container runtime  %s\n' "${DETECTED_NVIDIA_RUNTIME}"
  printf '  Container GPU      %s\n' "${DETECTED_CONTAINER_GPU}"

  if ! compute_resolve "${COMPUTE_MODE}" "${DETECTED_GPU_USABLE}" \
      "${DETECTED_CUDA_COMPATIBILITY}" "${DETECTED_OS}" "${DETECTED_ARCH}" \
      "${DETECTED_CONTAINER_ENGINE}"; then
    resolution="${COMPUTE_RESOLUTION_REASON}"
    failures=$((failures + 1))
  fi
  printf '\nCompute\n'
  printf '  Requested mode     %s\n' "${COMPUTE_MODE}"
  printf '  Configured backend %s\n' "${PYTORCH_BACKEND}"
  printf '  Recommended now    %s\n' "${COMPUTE_RESOLVED_BACKEND:-unavailable}"
  printf '  PyTorch version    %s\n' "$(compute_matrix_value PYTORCH_VERSION)"
  if [[ "${resolution}" != "ready" ]]; then
    printf '  Resolution         FAIL (%s)\n' "${resolution}"
  elif [[ -n "${COMPUTE_RESOLUTION_REASON}" ]]; then
    printf '  Resolution         WARN (%s)\n' "${COMPUTE_RESOLUTION_REASON}"
  else
    printf '  Resolution         OK\n'
  fi
  cmd_compute_observed main memory-proxy

  printf '\nPorts\n'
  local port
  for port in 6333 8080 8082 9001 9002 9100 9200; do
    printf '  %-18s %s\n' "${port}" "$(port_status "${port}")"
  done

  printf '\nModel\n'
  if [[ -f "${AI_STACK_HOME}/models/${MODEL_FILE}" ]]; then
    printf '  File               OK (%s)\n' "${AI_STACK_HOME}/models/${MODEL_FILE}"
  else
    printf '  File               MISSING (%s)\n' "${AI_STACK_HOME}/models/${MODEL_FILE}"
  fi

  printf '\nResult\n'
  if (( failures == 0 )); then
    printf '  READY\n'
    return 0
  fi
  printf '  NOT READY (%s issue(s))\n' "${failures}"
  return 1
}

cmd_hardware() {
  load_env
  detect_resources "${COMPUTE_MODE}" cached
  printf 'AI Stack VM Hardware\n====================\n'
  print_detected_resources
  printf 'Compose: %s\n' "$(compose_available && printf 'available' || printf 'not detected')"
  printf 'Ports:'
  local port
  for port in 6333 8080 8082 9001 9002 9100 9200; do
    printf ' %s=%s' "${port}" "$(port_status "${port}")"
  done
  printf '\n'
}

cmd_compute_observed() {
  local scope="${1:-main}"
  local service="${2:-memory-proxy}"
  if ! compose_available || ! compose_service_exists "${scope}" "${service}"; then
    printf 'Observed compute: %s is not running\n' "${service}"
    return 0
  fi
  if ! compose_scope "${scope}" exec -T "${service}" python -c \
      'import os, torch; print(f"Observed compute: wheel_cuda={torch.version.cuda or '\''none'\''} cuda_available={torch.cuda.is_available()} embedding_device={os.getenv('\''EMBEDDING_DEVICE'\'', '\''cpu'\'')}")'; then
    printf 'Observed compute: unable to inspect %s\n' "${service}"
  fi
}

cmd_compute() {
  local sub="${1:-status}"
  load_env
  if [[ "${sub}" == "status" ]]; then
    printf 'Compute mode: %s\n' "${COMPUTE_MODE}"
    printf 'PyTorch backend: %s\n' "${PYTORCH_BACKEND}"
    printf 'Embedding device: %s\n' "${EMBEDDING_DEVICE}"
    printf 'PyTorch version: %s\n' "$(compute_matrix_value PYTORCH_VERSION)"
    cmd_compute_observed main memory-proxy
    return 0
  fi
  case "${sub}" in auto|cpu|gpu) ;; *) fail "usage: ./ai-stack compute status|auto|cpu|gpu" ;; esac

  detect_resources "${sub}" pull
  resolve_compute_selection "${sub}"
  [[ -f "${ENV_FILE}" ]] && backup_env
  cmd_init
  set_env_var COMPUTE_MODE "${SELECTED_COMPUTE_MODE}"
  set_env_var PYTORCH_BACKEND "${SELECTED_PYTORCH_BACKEND}"
  set_env_var EMBEDDING_DEVICE "${SELECTED_EMBEDDING_DEVICE}"
  info "compute configuration updated: mode=${SELECTED_COMPUTE_MODE}, backend=${SELECTED_PYTORCH_BACKEND}, device=${SELECTED_EMBEDDING_DEVICE}"
  info "rebuild and recreate services to apply the change: ./ai-stack build && ./ai-stack up"
}

write_root_env() {
  local cpus mem threads cpu_limit memory_limit memory_reservation home_dir
  cpus="$(cpu_count)"
  mem="$(memory_gb)"
  threads="$(default_threads "${cpus}")"
  cpu_limit=$((threads + 2))
  if (( cpu_limit > cpus )); then
    cpu_limit="${cpus}"
  fi
  memory_limit="$(default_memory_limit "${mem}")"
  memory_reservation="$(default_memory_reservation "${mem}")"
  home_dir="${HOME}/ai-stack"

  if [[ -f "${ENV_FILE}" ]]; then
    info ".env already exists"
    return
  fi

  cat > "${ENV_FILE}" <<EOF
# AI Stack runtime
AI_STACK_HOME=${home_dir}

# Model selection
MODEL_NAME=${DEFAULT_MODEL_NAME}
MODEL_FILE=${DEFAULT_MODEL_FILE}
MODEL_PROFILE=laptop
MODEL_URL=${DEFAULT_MODEL_URL}
MODEL_SHA256=

# Network binding
BIND_HOST=127.0.0.1
OPEN_WEBUI_BIND_HOST=0.0.0.0
DASHBOARD_BIND_HOST=0.0.0.0

# Security
SECURITY_MODE=development
AI_STACK_API_KEY=
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60
SKIP_UTILITY_PROMPTS=true

# Dashboard login
DASHBOARD_AUTH_MODE=auto
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=

# llama.cpp runtime
LLAMA_THREADS=${threads}
LLAMA_CONTEXT=8192
LLAMA_BATCH=512
LLAMA_UBATCH=256
LLAMA_CPU_LIMIT=${cpu_limit}
LLAMA_MEMORY_LIMIT=${memory_limit}
LLAMA_CPU_RESERVATION=4
LLAMA_MEMORY_RESERVATION=${memory_reservation}

# Embedding compute (llama.cpp remains independently CPU-configured)
COMPUTE_MODE=auto
PYTORCH_BACKEND=cpu
EMBEDDING_DEVICE=cpu
MODEL_EXPECTED_SIZE_GB=

# Shared retrieval services
QDRANT_HOST=qdrant
QDRANT_PORT=6333
MEMORY_COLLECTION=engineering-memory
CODE_COLLECTION=code-memory
LLM_BASE_URL=http://vm-llama:8082/v1
EMBED_MODEL_NAME=all-MiniLM-L6-v2
HF_TOKEN=

# Memory proxy
MEMORY_API_LOGS=true
MEMORY_API_LOG_FILE=/logs/memory/memory_api.log
MEMORY_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.25

# Code proxy
CODE_PROXY_LOGS=true
CODE_PROXY_LOG_FILE=/logs/code/code_proxy.log
CODE_TOP_K=8
SEARCH_LIMIT_MULTIPLIER=4
CODE_SCORE_THRESHOLD=0.25
