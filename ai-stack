cmd_demo_clean() {
  load_env
  local memory_dst code_src_root code_dst_root repo_dir repo_name code_dst
  memory_dst="${AI_STACK_HOME}/memory/engineering-memory/demo"
  code_src_root="${ROOT_DIR}/demo/code-memory"
  code_dst_root="${AI_STACK_HOME}/memory/code-memory"

  case "${memory_dst}" in
    "${AI_STACK_HOME}/memory/engineering-memory/demo") ;;
    *) fail "refusing to remove unexpected memory path: ${memory_dst}" ;;
  esac

  if [[ -d "${memory_dst}" ]]; then
    rm -rf "${memory_dst}"
    info "removed ${memory_dst}"
  else
    info "demo memory directory was not present"
  fi

  shopt -s nullglob
  for repo_dir in "${code_src_root}"/*; do
    [[ -d "${repo_dir}" ]] || continue
    repo_name="$(basename "${repo_dir}")"
    code_dst="${code_dst_root}/${repo_name}"
    case "${code_dst}" in
      "${AI_STACK_HOME}/memory/code-memory/"*) ;;
      *) fail "refusing to remove unexpected code path: ${code_dst}" ;;
    esac
    if [[ -d "${code_dst}" ]]; then
      rm -rf "${code_dst}"
      info "removed ${code_dst}"
    else
      info "demo code directory was not present: ${code_dst}"
    fi
  done
  shopt -u nullglob

  warn "Qdrant may still contain previously indexed demo vectors until you re-index or reset collections."
}

cmd_demo() {
  local sub="${1:-}"
  if [[ "${sub}" == "clean" ]]; then
    cmd_demo_clean
    return
  elif [[ "${sub}" == "reset-vectors" ]]; then
    cmd_qdrant reset demo
    return
  elif [[ "${sub}" == "run" ]]; then
    shift || true
    cmd_up
    cmd_dashboard
    cmd_agentic_rag up
    sub=""
  elif [[ -n "${sub}" ]]; then
    fail "usage: ./ai-stack demo [clean|run|reset-vectors]"
  fi

  cmd_init
  load_env

  local memory_src code_src_root memory_dst code_dst_root existing action repo_dir repo_name code_dst
  memory_src="${ROOT_DIR}/demo/engineering-memory"
  code_src_root="${ROOT_DIR}/demo/code-memory"
  memory_dst="${AI_STACK_HOME}/memory/engineering-memory/demo"
  code_dst_root="${AI_STACK_HOME}/memory/code-memory"
  existing=0

  [[ -d "${memory_src}" ]] || fail "missing demo source: ${memory_src}"
  [[ -d "${code_src_root}" ]] || fail "missing demo source: ${code_src_root}"

  if [[ -e "${memory_dst}" ]]; then
    existing=1
  fi
  shopt -s nullglob
  for repo_dir in "${code_src_root}"/*; do
    [[ -d "${repo_dir}" ]] || continue
    repo_name="$(basename "${repo_dir}")"
    if [[ -e "${code_dst_root}/${repo_name}" ]]; then
      existing=1
    fi
  done

  if (( existing == 1 )); then
    action="$(prompt_demo_existing)"
  else
    action="replace"
  fi

  if [[ "${action}" == "replace" ]]; then
    if (( existing == 1 )); then
      rm -rf "${memory_dst}"
      for repo_dir in "${code_src_root}"/*; do
        [[ -d "${repo_dir}" ]] || continue
        repo_name="$(basename "${repo_dir}")"
        rm -rf "${code_dst_root}/${repo_name}"
      done
    fi
    mkdir -p "$(dirname "${memory_dst}")" "${code_dst_root}"
    cp -R "${memory_src}" "${memory_dst}"
    for repo_dir in "${code_src_root}"/*; do
      [[ -d "${repo_dir}" ]] || continue
      repo_name="$(basename "${repo_dir}")"
      cp -R "${repo_dir}" "${code_dst_root}/${repo_name}"
    done
    info "copied demo content into ${AI_STACK_HOME}/memory"
  else
    if [[ ! -e "${memory_dst}" ]]; then
      mkdir -p "$(dirname "${memory_dst}")"
      cp -R "${memory_src}" "${memory_dst}"
      info "copied missing demo memory into ${memory_dst}"
    fi
    mkdir -p "${code_dst_root}"
    for repo_dir in "${code_src_root}"/*; do
      [[ -d "${repo_dir}" ]] || continue
      repo_name="$(basename "${repo_dir}")"
      if [[ ! -e "${code_dst_root}/${repo_name}" ]]; then
        cp -R "${repo_dir}" "${code_dst_root}/${repo_name}"
        info "copied missing demo repo into ${code_dst_root}/${repo_name}"
      fi
    done
    info "skipped overwriting existing demo content"
  fi
  shopt -u nullglob

  cmd_index memory
  shopt -s nullglob
  for repo_dir in "${code_src_root}"/*; do
    [[ -d "${repo_dir}" ]] || continue
    repo_name="$(basename "${repo_dir}")"
    code_dst="${code_dst_root}/${repo_name}"
    cmd_index code "${code_dst}"
  done
  shopt -u nullglob
  print_demo_questions
}

main() {
  cd "${ROOT_DIR}"
  local command="${1:-help}"
  shift || true

  case "${command}" in
    help|-h|--help) usage ;;
    doctor) cmd_doctor "$@" ;;
    hardware) cmd_hardware "$@" ;;
    compute) cmd_compute "$@" ;;
    install) cmd_install "$@" ;;
    init) cmd_init "$@" ;;
    profile) cmd_profile "$@" ;;
    build) cmd_build "$@" ;;
    up) cmd_up "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    agentic-rag) cmd_agentic_rag "$@" ;;
    down) cmd_down "$@" ;;
    restart) cmd_restart "$@" ;;
    apply-config) cmd_apply_config "$@" ;;
    status) cmd_status "$@" ;;
    smoke) cmd_smoke "$@" ;;
    qdrant) cmd_qdrant "$@" ;;
    benchmark) cmd_benchmark "$@" ;;
    logs) cmd_logs "$@" ;;
    index) cmd_index "$@" ;;
    search) cmd_search "$@" ;;
    demo) cmd_demo "$@" ;;
    model)
      local sub="${1:-}"
      shift || true
      case "${sub}" in
        list) cmd_model_list "$@" ;;
        path) cmd_model_path "$@" ;;
        add) cmd_model_add "$@" ;;
        use) cmd_model_use "$@" ;;
        download) cmd_model_download "$@" ;;
        *) fail "usage: ./ai-stack model list|path|add|use|download" ;;
      esac
      ;;
    *) fail "unknown command: ${command}" ;;
  esac
}

main "$@"
