    2) printf 'Best balance for coding and RAG on stronger VMs or workstations. Suggested minimum: 12-16 GB RAM.' ;;
    3) printf 'High-resource preset. The installer asks for its direct GGUF URL and optional size/checksum.' ;;
    4) printf 'Enter any single-file GGUF model compatible with llama.cpp.' ;;
    *) return 1 ;;
  esac
