model_fallback_size_gb() {
  case "$1" in
    1) printf '2' ;;
    2) printf '5' ;;
    *) printf '0' ;;
  esac
}

remote_file_size_gb() {
  local url="$1"
  local headers bytes auth_args=()
  [[ -n "${url}" ]] || return 1
  if [[ -n "${HF_TOKEN:-}" ]]; then
    auth_args=(-H "Authorization: Bearer ${HF_TOKEN}")
  fi
  headers="$(curl --silent --show-error --fail --location --head "${auth_args[@]}" "${url}" 2>/dev/null || true)"
  bytes="$(printf '%s\n' "${headers}" | awk '
    BEGIN { max=0 }
    tolower($1) == "content-length:" || tolower($1) == "x-linked-size:" {
      gsub("\\r", "", $2)
      if (($2 + 0) > max) max=$2 + 0
    }
    END { if (max > 0) printf "%.0f", max }
  ')"
  [[ -n "${bytes}" ]] || return 1
  awk -v bytes="${bytes}" 'BEGIN { printf "%d", (bytes + 1073741823) / 1073741824 }'
}

model_remaining_size_gb() {
  local choice="$1"
  local file url dest expected local_bytes local_gb
  file="$(model_file_for_choice "${choice}")"
  url="$(model_url_for_choice "${choice}")"
  dest="${AI_STACK_HOME}/models/${file}"
  if [[ -z "${url}" ]]; then
    if [[ -f "${dest}" ]]; then
      printf '0'
      return 0
    fi
    fail "${file} is not present and its MODEL_URL is empty; configure a valid model URL or choose another model"
  fi

  expected="$(model_expected_size_for_choice "${choice}")"
  if [[ -z "${expected}" ]]; then
    expected="$(remote_file_size_gb "${url}" || true)"
  fi
  if [[ -z "${expected}" || "${expected}" == "0" ]]; then
    expected="$(model_fallback_size_gb "${choice}")"
  fi
  [[ -n "${expected}" && "${expected}" != "0" ]] || fail "could not determine model size; set MODEL_EXPECTED_SIZE_GB before installing"
  [[ "${expected}" =~ ^[0-9]+$ ]] || fail "MODEL_EXPECTED_SIZE_GB must be a whole number"

  local_bytes=0
  [[ -f "${dest}" ]] && local_bytes="$(stat -c '%s' "${dest}" 2>/dev/null || printf '0')"
  local_gb="$(awk -v bytes="${local_bytes}" 'BEGIN { printf "%d", bytes / 1073741824 }')"
  if (( expected > local_gb )); then
    printf '%s' "$((expected - local_gb))"
  else
    printf '0'
  fi
}

storage_preflight() {
  local choice="$1"
  local backend="$2"
  local remaining shared_filesystem=false
  remaining="$(model_remaining_size_gb "${choice}")"
  hardware_same_storage_device && shared_filesystem=true
  hardware_storage_requirements "${remaining}" "${backend}" "${shared_filesystem}"

  STORAGE_MODEL_REMAINING_GB="${remaining}"
  if [[ "${shared_filesystem}" == "true" ]]; then
    STORAGE_MINIMUM_GB="${STORAGE_RUNTIME_MIN_GB}"
    STORAGE_RECOMMENDED_GB="${STORAGE_RUNTIME_RECOMMENDED_GB}"
    STORAGE_AVAILABLE_GB="${DETECTED_RUNTIME_DISK_FREE_GB:-0}"
    printf 'Model remaining: %s GiB\n' "${remaining}"
    printf 'Shared filesystem: %s GiB minimum / %s GiB recommended / %s GiB available\n' \
      "${STORAGE_MINIMUM_GB}" "${STORAGE_RECOMMENDED_GB}" "${STORAGE_AVAILABLE_GB}"
    (( STORAGE_AVAILABLE_GB >= STORAGE_MINIMUM_GB )) || fail "insufficient disk space; increase the VM disk or choose a smaller model"
    if (( STORAGE_AVAILABLE_GB < STORAGE_RECOMMENDED_GB )); then
      warn "disk space meets the minimum but is below the ${STORAGE_RECOMMENDED_GB} GiB recommendation"
    fi
    return 0
  fi

  printf 'Model remaining: %s GiB\n' "${remaining}"
  printf 'Runtime filesystem: %s GiB minimum / %s GiB recommended / %s GiB available\n' \
    "${STORAGE_RUNTIME_MIN_GB}" "${STORAGE_RUNTIME_RECOMMENDED_GB}" "${DETECTED_RUNTIME_DISK_FREE_GB:-0}"
  printf 'Container filesystem: %s GiB minimum / %s GiB recommended / %s GiB available\n' \
    "${STORAGE_DOCKER_MIN_GB}" "${STORAGE_DOCKER_RECOMMENDED_GB}" "${DETECTED_DOCKER_DISK_FREE_GB:-0}"
  (( DETECTED_RUNTIME_DISK_FREE_GB >= STORAGE_RUNTIME_MIN_GB )) || fail "insufficient runtime disk space"
  (( DETECTED_DOCKER_DISK_FREE_GB >= STORAGE_DOCKER_MIN_GB )) || fail "insufficient container storage space"
  if (( DETECTED_RUNTIME_DISK_FREE_GB < STORAGE_RUNTIME_RECOMMENDED_GB || DETECTED_DOCKER_DISK_FREE_GB < STORAGE_DOCKER_RECOMMENDED_GB )); then
    warn "storage meets the minimum but is below the recommended headroom"
  fi
}

