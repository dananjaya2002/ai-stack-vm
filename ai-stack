cmd_qdrant() {
  local sub="${1:-}"
  local target="${2:-}"
  load_env
  case "${sub}" in
    collections)
      curl --silent --show-error --fail --max-time 10 "http://localhost:6333/collections"
      printf '\n'
      ;;
    reset)
      case "${target}" in
        memory)
          confirm_reset memory
          qdrant_delete_collection "${MEMORY_COLLECTION:-engineering-memory}"
          info "deleted Qdrant collection: ${MEMORY_COLLECTION:-engineering-memory}"
          ;;
        code)
          confirm_reset code
          qdrant_delete_collection "${CODE_COLLECTION:-code-memory}"
          info "deleted Qdrant collection: ${CODE_COLLECTION:-code-memory}"
          ;;
        demo)
          confirm_reset demo
          qdrant_delete_points "${MEMORY_COLLECTION:-engineering-memory}" '{"filter":{"must":[{"key":"category","match":{"value":"demo"}}]}}' || warn "demo memory vector cleanup skipped or failed"
          qdrant_delete_points "${CODE_COLLECTION:-code-memory}" '{"filter":{"should":[{"key":"repo","match":{"value":"sample-python-app"}},{"key":"repo","match":{"value":"sample-repository-app"}}]}}' || warn "demo code vector cleanup skipped or failed"
          info "deleted demo vectors where matching payloads were found"
          ;;
        *)
          fail "usage: ./ai-stack qdrant reset memory|code|demo"
          ;;
      esac
      ;;
    *)
      fail "usage: ./ai-stack qdrant collections|reset"
      ;;
  esac
}

