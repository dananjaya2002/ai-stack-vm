# llama.cpp runtime
LLAMA_THREADS=${threads}
LLAMA_CONTEXT=8192
LLAMA_BATCH=512
LLAMA_UBATCH=256
LLAMA_CPU_LIMIT=${cpu_limit}
LLAMA_MEMORY_LIMIT=${memory_limit}
LLAMA_CPU_RESERVATION=4
LLAMA_MEMORY_RESERVATION=${memory_reservation}

# Shared retrieval services
QDRANT_HOST=qdrant
