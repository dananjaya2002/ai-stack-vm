info() {
  printf '[ai-stack] %s\n' "$*"
}

warn() {
  printf '[ai-stack] WARN: %s\n' "$*" >&2
}

fail() {
  printf '[ai-stack] FAIL: %s\n' "$*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

compose() {
  if have docker && docker info >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif have docker && docker info >/dev/null 2>&1 && have docker-compose; then
    docker-compose "$@"
  elif have podman && podman info >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
    podman compose "$@"
  elif have podman && podman info >/dev/null 2>&1 && have podman-compose; then
    podman-compose "$@"
  else
    fail "Compose was not found. Install Docker Compose, podman-compose, or a Podman version with 'podman compose'."
  fi
}

compose_available() {
  if have docker && docker info >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    return 0
  elif have docker && docker info >/dev/null 2>&1 && have docker-compose; then
    return 0
  elif have podman && podman info >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
    return 0
  elif have podman && podman info >/dev/null 2>&1 && have podman-compose; then
    return 0
  fi
  return 1
}

compose_backend() {
  load_env
  compute_backend_exists "${PYTORCH_BACKEND}" || fail "unsupported PYTORCH_BACKEND=${PYTORCH_BACKEND}; run ./ai-stack compute auto"
  printf '%s' "${PYTORCH_BACKEND}"
}

compose_scope() {
  local scope="$1"
  shift
  local backend file scope_files
  local compose_args=()
  backend="$(compose_backend)"

  if compute_is_gpu_backend "${backend}" && \
     ! (have docker && docker info >/dev/null 2>&1 && docker compose version >/dev/null 2>&1); then
    fail "GPU mode requires the Docker Compose plugin; Podman and legacy docker-compose are CPU-only in this release"
  fi

  scope_files="$(compose_files_for_scope "${scope}" "${backend}")" || fail "unknown Compose scope: ${scope}"
  while IFS= read -r file; do
    compose_args+=(-f "${file}")
  done <<< "${scope_files}"
  compose "${compose_args[@]}" "$@"
}

compose_main() { compose_scope main "$@"; }
compose_dashboard() { compose_scope dashboard "$@"; }
compose_agentic() { compose_scope agentic "$@"; }

