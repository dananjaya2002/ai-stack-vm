detect_resources() {
  load_env
  DETECTED_CPU_CORES="$(cpu_count)"
  DETECTED_RAM_GB="$(memory_gb)"
  DETECTED_AVAILABLE_RAM_GB="$(available_memory_gb)"
  DETECTED_DISK_FREE_GB="$(disk_free_gb "${AI_STACK_HOME}")"
  DETECTED_DISK_FREE_GB="${DETECTED_DISK_FREE_GB:-0}"
  DETECTED_GPU_NAME="none"
  DETECTED_GPU_VRAM_GB="0"
  DETECTED_NVIDIA_TOOLKIT="not detected"

  if have nvidia-smi; then
    local gpu_line gpu_name gpu_vram_mb
    gpu_line="$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)"
    if [[ -n "${gpu_line}" ]]; then
      gpu_name="${gpu_line%,*}"
      gpu_vram_mb="${gpu_line##*,}"
      gpu_name="$(printf '%s' "${gpu_name}" | awk '{$1=$1; print}')"
      gpu_vram_mb="$(printf '%s' "${gpu_vram_mb}" | awk '{$1=$1; print}')"
      DETECTED_GPU_NAME="${gpu_name}"
      DETECTED_GPU_VRAM_GB="$(awk -v mb="${gpu_vram_mb}" 'BEGIN { printf "%.0f", mb / 1024 }')"
    fi
  fi

  if [[ "${DETECTED_GPU_NAME}" != "none" ]]; then
    if have docker && docker info 2>/dev/null | grep -qi nvidia; then
      DETECTED_NVIDIA_TOOLKIT="docker nvidia runtime detected"
    elif have podman && podman info 2>/dev/null | grep -qi nvidia; then
      DETECTED_NVIDIA_TOOLKIT="podman nvidia runtime detected"
    else
      DETECTED_NVIDIA_TOOLKIT="not detected"
    fi
  fi
}

recommend_model() {
  if (( DETECTED_RAM_GB < 12 )); then
    RECOMMENDED_MODEL_CHOICE="1"
  elif (( DETECTED_RAM_GB < 32 )); then
    RECOMMENDED_MODEL_CHOICE="2"
  else
    RECOMMENDED_MODEL_CHOICE="3"
  fi
}

print_detected_resources() {
  printf '\nDetected system resources:\n\n'
  printf 'CPU cores: %s\n' "${DETECTED_CPU_CORES}"
  printf 'RAM: %s GB total, %s GB available\n' "${DETECTED_RAM_GB}" "${DETECTED_AVAILABLE_RAM_GB}"
  printf 'Disk free: %s GB under %s\n' "${DETECTED_DISK_FREE_GB}" "${AI_STACK_HOME}"
  if [[ "${DETECTED_GPU_NAME}" == "none" ]]; then
    printf 'GPU: none detected\n'
  else
    printf 'GPU: %s, %s GB VRAM\n' "${DETECTED_GPU_NAME}" "${DETECTED_GPU_VRAM_GB}"
    printf 'NVIDIA Container Toolkit: %s\n' "${DETECTED_NVIDIA_TOOLKIT}"
  fi
  printf '\nRecommended model: %s\n' "$(model_name_for_choice "${RECOMMENDED_MODEL_CHOICE}")"
}

prompt_yes_no() {
  local prompt="$1"
  local answer
  read -r -p "${prompt}" answer || return 1
  case "${answer}" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_model_selection() {
  local choice selected_name
  print_detected_resources

  if (( DETECTED_DISK_FREE_GB > 0 && DETECTED_DISK_FREE_GB < 20 )); then
    warn "disk free space is low (${DETECTED_DISK_FREE_GB} GB). Model downloads and container builds may fail."
    if ! prompt_yes_no "Continue anyway? [y/N]: "; then
      info "install cancelled"
      exit 0
    fi
  fi

  while true; do
    cat <<EOF

Choose model to install:

[1] ${DEFAULT_MODEL_NAME}
    $(model_description_for_choice 1)

[2] ${MODEL_7B_NAME}
    $(model_description_for_choice 2)

[3] ${VM60_MODEL_NAME}
    $(model_description_for_choice 3)

EOF
    read -r -p "Enter choice [recommended: ${RECOMMENDED_MODEL_CHOICE}]: " choice || {
      info "install cancelled"
      exit 0
    }
    choice="${choice:-${RECOMMENDED_MODEL_CHOICE}}"
    case "${choice}" in
      1|2|3)
        if [[ "${choice}" == "3" && "${DETECTED_RAM_GB}" -lt 32 ]]; then
          warn "Qwen3.6-35B may exceed your available resources and may be slow or unstable."
          if ! prompt_yes_no "Continue anyway? [y/N]: "; then
            continue
          fi
        fi
        SELECTED_MODEL_CHOICE="${choice}"
        selected_name="$(model_name_for_choice "${choice}")"
        info "selected model: ${selected_name}"
        return
        ;;
      *)
        warn "invalid choice: ${choice}"
        ;;
    esac
  done
}

backup_env() {
  if [[ -f "${ENV_FILE}" ]]; then
    local backup
    backup="${ENV_FILE}.backup-$(date +%Y%m%d-%H%M%S)"
