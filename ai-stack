require_install_dependencies() {
  for bin in git curl awk; do
    have "${bin}" || fail "${bin} is required for install"
  done

  if ! (have docker && docker info >/dev/null 2>&1) && \
     ! (have podman && podman info >/dev/null 2>&1); then
    fail "a running Docker or Podman engine is required for install"
  fi

  if ! compose_available; then
    fail "Compose was not found. Install Docker Compose, podman-compose, or a Podman version with 'podman compose'."
  fi
}

install_stack() {
  local requested_compute="$1"
  local env_existed=0 selected_file selected_url selected_dest
  [[ -f "${ENV_FILE}" ]] && env_existed=1

  printf 'AI Stack VM Installer\n=====================\n'

  install_stage 1 "Checking host prerequisites"
  require_install_dependencies
  info "OK prerequisites available"

  install_stage 2 "Detecting hardware"
  detect_resources "${requested_compute}" pull
  print_detected_resources

  install_stage 3 "Selecting compute backend"
  resolve_compute_selection "${requested_compute}"
  info "requested: ${requested_compute}"
  info "selected: ${SELECTED_PYTORCH_BACKEND} (${SELECTED_EMBEDDING_DEVICE})"
  if [[ -n "${COMPUTE_RESOLUTION_REASON}" ]]; then
    warn "${COMPUTE_RESOLUTION_REASON}; falling back to CPU"
  fi

  install_stage 4 "Selecting AI model"
  recommend_model
  prompt_model_selection

  install_stage 5 "Checking storage requirements"
  storage_preflight "${SELECTED_MODEL_CHOICE}" "${SELECTED_PYTORCH_BACKEND}"
  info "OK storage preflight passed"

  install_stage 6 "Preparing configuration"
  if (( env_existed == 1 )); then
    backup_env
  fi
  cmd_init
  write_model_env "${SELECTED_MODEL_CHOICE}"
  set_env_var COMPUTE_MODE "${SELECTED_COMPUTE_MODE}"
  set_env_var PYTORCH_BACKEND "${SELECTED_PYTORCH_BACKEND}"
  set_env_var EMBEDDING_DEVICE "${SELECTED_EMBEDDING_DEVICE}"
  load_env

  selected_file="${MODEL_FILE}"
  selected_url="${MODEL_URL}"
  selected_dest="${AI_STACK_HOME}/models/${selected_file}"

  install_stage 7 "Preparing model"
  if [[ -f "${selected_dest}" && "${STORAGE_MODEL_REMAINING_GB}" == "0" ]]; then
    info "SKIP model already exists: ${selected_dest}"
  elif [[ -n "${selected_url}" ]]; then
    cmd_model_download "${selected_url}"
  else
    fail "MODEL_URL is empty and the selected model is not available locally"
  fi

  install_stage 8 "Building containers"
  cmd_build
  install_stage 9 "Starting services"
  cmd_up
  install_stage 10 "Running verification"
  cmd_status

  printf '\nInstallation complete.\n'
  printf 'Open WebUI: http://localhost:8080\n'
  printf 'Dashboard: run ./ai-stack dashboard, then open http://localhost:9100\n'
  printf 'Compute: %s / %s\n' "${PYTORCH_BACKEND}" "${EMBEDDING_DEVICE}"
}

cmd_install() {
  local requested=""
  load_env
  while (( $# > 0 )); do
    case "$1" in
      --compute)
        [[ $# -ge 2 ]] || fail "--compute requires auto, cpu, or gpu"
        requested="$2"
        shift 2
        ;;
      --compute=*) requested="${1#*=}"; shift ;;
      *) fail "usage: ./ai-stack install [--compute auto|cpu|gpu]" ;;
    esac
  done
  requested="${requested:-${COMPUTE_MODE}}"
  case "${requested}" in auto|cpu|gpu) ;; *) fail "unsupported compute mode: ${requested}" ;; esac
  install_stack "${requested}"
}

