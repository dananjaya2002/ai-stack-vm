curl_check() {
  local name="$1"
  local url="$2"
  shift 2
  local code
  code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 8 "$@" "${url}" || true)"
  if [[ "${code}" =~ ^[23] ]]; then
    info "${name}: ok (${code})"
    return 0
  fi
  warn "${name}: failed (${code:-curl-error}) at ${url}"
  return 1
}

cmd_smoke() {
  local mode="${1:-development}"
  local failures=0
  cmd_init
  load_env

  compose_available || fail "compose is not available"
  [[ -f "${ENV_FILE}" ]] || { warn ".env is missing"; failures=$((failures + 1)); }
  [[ -f "${AI_STACK_HOME}/models/${MODEL_FILE}" ]] || { warn "model file is missing: ${AI_STACK_HOME}/models/${MODEL_FILE}"; failures=$((failures + 1)); }

  curl_check "qdrant" "http://localhost:6333" || failures=$((failures + 1))
  curl_check "llama" "http://localhost:8082/v1/models" || failures=$((failures + 1))

  local auth_args=()
  if [[ -n "${AI_STACK_API_KEY}" ]]; then
    auth_args=(-H "Authorization: Bearer ${AI_STACK_API_KEY}")
  fi
  curl_check "code-proxy" "http://localhost:9001/v1/models" "${auth_args[@]}" || failures=$((failures + 1))
  curl_check "memory-proxy" "http://localhost:9002/v1/models" "${auth_args[@]}" || failures=$((failures + 1))
  curl_check "dashboard" "http://localhost:9100/api/dashboard/auth/status" || failures=$((failures + 1))
  curl_check "agentic-rag" "http://localhost:9200/v1/models" "${auth_args[@]}" || failures=$((failures + 1))

  if [[ "${mode}" == "production" ]]; then
    [[ -n "${AI_STACK_API_KEY}" ]] || fail "AI_STACK_API_KEY is required for production smoke checks"
    local no_auth_code with_auth_code
    no_auth_code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 8 http://localhost:9001/v1/models || true)"
    with_auth_code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 8 -H "Authorization: Bearer ${AI_STACK_API_KEY}" http://localhost:9001/v1/models || true)"
    if [[ "${no_auth_code}" == "401" && "${with_auth_code}" =~ ^[23] ]]; then
      info "production bearer auth: ok"
    else
      warn "production bearer auth: expected 401 without token and 2xx with token, got ${no_auth_code}/${with_auth_code}"
      failures=$((failures + 1))
    fi
  elif [[ "${mode}" != "development" ]]; then
    fail "usage: ./ai-stack smoke [production]"
  fi

  if (( failures > 0 )); then
    fail "smoke checks failed: ${failures}"
  fi
  info "smoke checks passed"
}

