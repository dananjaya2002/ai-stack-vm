CODE_PROXY_LOGS=true
CODE_PROXY_LOG_FILE=/logs/code-proxy/code_proxy.log

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=code-memory

LLM_BASE_URL=http://host.docker.internal:8082/v1
LLM_MODEL=qwen2.5-coder-7b-instruct-q4_k_m.gguf

CODE_TOP_K=8
SEARCH_LIMIT_MULTIPLIER=4
CODE_SCORE_THRESHOLD=0.25
MAX_CHUNKS_PER_FILE=2
MAX_TEXT_PREVIEW_CHARS=1200
REPOS_ROOT=/code-memory
