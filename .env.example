# AI Stack runtime
AI_STACK_HOME=/home/ubuntu/ai-stack

# Model selection
MODEL_NAME=Qwen2.5-Coder-3B-Instruct-Q4_K_M
MODEL_FILE=Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf
MODEL_PROFILE=laptop
MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-Coder-3B-Instruct-GGUF/resolve/main/Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf
MODEL_SHA256=

# Network binding
BIND_HOST=127.0.0.1
OPEN_WEBUI_BIND_HOST=0.0.0.0
DASHBOARD_BIND_HOST=0.0.0.0

# Security
SECURITY_MODE=development
AI_STACK_API_KEY=
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60
SKIP_UTILITY_PROMPTS=true

# Dashboard login
DASHBOARD_AUTH_MODE=auto
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=

# llama.cpp runtime
LLAMA_THREADS=6
LLAMA_CONTEXT=8192
LLAMA_BATCH=512
LLAMA_UBATCH=256
LLAMA_CPU_LIMIT=8
LLAMA_MEMORY_LIMIT=14gb
LLAMA_CPU_RESERVATION=4
LLAMA_MEMORY_RESERVATION=8gb

# Shared retrieval services
QDRANT_HOST=qdrant
QDRANT_PORT=6333
MEMORY_COLLECTION=engineering-memory
CODE_COLLECTION=code-memory
# Internal Compose URL used by containers. Use host localhost only for external clients.
LLM_BASE_URL=http://vm-llama:8082/v1
EMBED_MODEL_NAME=all-MiniLM-L6-v2
HF_TOKEN=

# Memory proxy
MEMORY_API_LOGS=true
MEMORY_API_LOG_FILE=/logs/memory/memory_api.log
MEMORY_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.25

# Code proxy
CODE_PROXY_LOGS=true
CODE_PROXY_LOG_FILE=/logs/code/code_proxy.log
CODE_TOP_K=8
SEARCH_LIMIT_MULTIPLIER=4
CODE_SCORE_THRESHOLD=0.25
MAX_CHUNKS_PER_FILE=2
MAX_TEXT_PREVIEW_CHARS=1200
MAX_CHUNK_CHARS=4000
MAX_CONTEXT_CHARS=50000

# Agentic RAG
AGENTIC_RAG_LOGS=true
AGENTIC_RAG_LOG_FILE=/logs/agentic-rag/agentic_rag.log
ENABLE_INDEX_V2=true
ENABLE_AGENTIC_RETRIEVAL=true
AGENTIC_MAX_STEPS=4
AGENTIC_INITIAL_SUBQUERIES=3
AGENTIC_FOLLOWUP_TOP_K=4
AGENTIC_MAX_TOTAL_CHUNKS=16
AGENTIC_MIN_CONFIDENCE=0.70
AGENTIC_TOP_K_PER_QUERY=3
SIMPLE_TOP_K=6
AGENTIC_SCORE_THRESHOLD=0.20
