{
  "ignore_dirs": [
    ".git",
    "node_modules",
    "dist",
    ".vite",
    "build",
    "target",
    ".next",
    ".nuxt",
    "coverage",
    "__pycache__",
    ".venv",
    "tmp",
    "temp",
    "cache",
    ".cache",
    "venv",
    "env",
    ".idea",
    ".vscode",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".terraform"
  ],
  "ignore_suffixes": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".svg",
    ".zip",
    ".tar",
    ".gz",
    ".7z",
    ".rar",
    ".pdf",
    ".docx",
    ".xlsx",
    ".pptx",
    ".lock",
    ".log",
    ".map",
    ".gguf",
    ".bin",
    ".onnx",
    ".sqlite",
    ".db",
    ".mp4",
    ".mp3",
    ".wav"
  ],
  "language_by_extension": {
    ".py": "python",
    ".js": "javascript",
    ".jsx": "javascriptreact",
    ".ts": "typescript",
    ".tsx": "typescriptreact",
    ".dart": "dart",
    ".java": "java",
    ".go": "go",
    ".rs": "rust",
    ".c": "c",
    ".h": "c",
    ".cpp": "cpp",
    ".hpp": "cpp",
    ".cs": "csharp",
    ".php": "php",
    ".rb": "ruby",
    ".sh": "shell",
    ".bash": "shell",
    ".zsh": "shell",
    ".yaml": "yaml",
    ".yml": "yaml",
    ".json": "json",
    ".md": "markdown",
    ".html": "html",
    ".css": "css",
    ".scss": "scss",
    ".sql": "sql",
    ".xml": "xml",
    ".toml": "toml",
    ".ini": "ini",
    ".env": "env"
  },
  "symbol_patterns": {
    "python": [
      {"type": "class", "pattern": "^\\s*class\\s+([A-Za-z_][A-Za-z0-9_]*)", "flags": ["MULTILINE"]},
      {"type": "async_function", "pattern": "^\\s*async\\s+def\\s+([A-Za-z_][A-Za-z0-9_]*)", "flags": ["MULTILINE"]},
      {"type": "function", "pattern": "^\\s*def\\s+([A-Za-z_][A-Za-z0-9_]*)", "flags": ["MULTILINE"]},
      {"type": "fastapi_route", "pattern": "^\\s*@app\\.(get|post|put|delete|patch)\\([^\\n]*", "flags": ["MULTILINE"]}
    ],
    "typescript": [
      {"type": "class", "pattern": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "export_function", "pattern": "\\bexport\\s+function\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "function", "pattern": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "arrow_function", "pattern": "\\bconst\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(?:async\\s*)?\\([^)]*\\)\\s*=>"}
    ],
    "typescriptreact": [
      {"type": "react_component", "pattern": "\\b(?:export\\s+default\\s+)?function\\s+([A-Z][A-Za-z0-9_]*)"},
      {"type": "react_component", "pattern": "\\bconst\\s+([A-Z][A-Za-z0-9_]*)\\s*=\\s*(?:\\([^)]*\\)|[A-Za-z0-9_]+)\\s*=>"},
      {"type": "class", "pattern": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "function", "pattern": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)"}
    ],
    "javascript": [
      {"type": "class", "pattern": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "function", "pattern": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "arrow_function", "pattern": "\\bconst\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(?:async\\s*)?\\([^)]*\\)\\s*=>"}
    ],
    "javascriptreact": [
      {"type": "react_component", "pattern": "\\b(?:export\\s+default\\s+)?function\\s+([A-Z][A-Za-z0-9_]*)"},
      {"type": "react_component", "pattern": "\\bconst\\s+([A-Z][A-Za-z0-9_]*)\\s*=\\s*(?:\\([^)]*\\)|[A-Za-z0-9_]+)\\s*=>"},
      {"type": "function", "pattern": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)"}
    ],
    "dart": [
      {"type": "class", "pattern": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "method", "pattern": "^\\s*(?:Future<[^>]+>|Future<void>|void|Widget|String|int|double|bool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(", "flags": ["MULTILINE"]}
    ],
    "java": [
      {"type": "class", "pattern": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)"},
      {"type": "interface", "pattern": "\\binterface\\s+([A-Za-z_][A-Za-z0-9_]*)"}
    ],
    "go": [
      {"type": "function", "pattern": "^func\\s+([A-Za-z_][A-Za-z0-9_]*)", "flags": ["MULTILINE"]},
      {"type": "method", "pattern": "^func\\s+\\([^)]+\\)\\s+([A-Za-z_][A-Za-z0-9_]*)", "flags": ["MULTILINE"]},
      {"type": "struct", "pattern": "^type\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+struct", "flags": ["MULTILINE"]}
    ]
  }
}
