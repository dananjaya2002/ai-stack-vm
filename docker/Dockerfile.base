# Dockerfile.base  –  Shared dependency image
# Build first with:  docker build -f docker/Dockerfile.base -t ai-stack/base-deps .
#
FROM python:3.11-slim
WORKDIR /app

# Install system build tools needed for some wheels (gcc, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy the merged requirements file from the project root
COPY requirements.txt ./requirements.txt

# Install all Python dependencies in one layer so downstream images reuse this cache
RUN pip install --no-cache-dir -r requirements.txt

# Create a non-root user (used by downstream service images)
RUN useradd -m appuser && chown -R appuser /app
USER appuser
