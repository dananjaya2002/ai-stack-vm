# docker/Dockerfile.base – Shared dependency image
# Build first with:  docker build -f docker/Dockerfile.base -t ai-stack/base-deps .
#
FROM docker.io/library/python:3.11-slim
WORKDIR /app

# Use one cache location for image build-time downloads and the non-root runtime user.
ENV HF_HOME=/opt/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/opt/huggingface/sentence-transformers

# 1. Install system build tools needed for some wheels (gcc, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

# 2. Copy the merged requirements file from the project root
COPY requirements.txt ./requirements.txt

# 3. Install all Python dependencies with CPU wheel forced
RUN pip install --no-cache-dir -r requirements.txt

# 4. Create a non-root user and pre-create the cache directories
RUN useradd -m -u 10001 appuser && \
    mkdir -p /home/appuser/.cache /opt/huggingface && \
    chown -R appuser:appuser /app /home/appuser /opt/huggingface

# 5. Pre-download the embedding weights so it doesn't fail at runtime
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# The runtime services use appuser and must be able to read locks/metadata in the cache.
RUN chown -R appuser:appuser /opt/huggingface

# CRITICAL FIX: Keep the base image user as root! 
# Downstream images will switch to appuser when they are ready.
USER root
