FROM docker.io/library/node:20-slim AS frontend-build

WORKDIR /frontend

COPY scripts/dashboard/frontend/package.json ./package.json
RUN npm install

COPY scripts/dashboard/frontend ./
RUN npm run build

FROM docker.io/library/python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/dashboard/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && \
    mkdir -p /root/.cache /tmp/ai-stack-dashboard

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY scripts/dashboard/dashboard_api.py ./dashboard_api.py
COPY --from=frontend-build /frontend/dist ./frontend/dist
COPY src ./src
COPY config ./config
COPY config.yaml ./config.yaml

EXPOSE 9100

CMD ["uvicorn", "dashboard_api:app", "--host", "0.0.0.0", "--port", "9100"]
