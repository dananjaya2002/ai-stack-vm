FROM docker.io/library/node:20-slim AS frontend-build

WORKDIR /frontend

COPY scripts/dashboard/frontend/package.json ./package.json
RUN npm install

COPY scripts/dashboard/frontend ./
RUN npm run build

FROM docker.io/library/python:3.11-slim

WORKDIR /app

ARG PYTORCH_BACKEND=cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY config/pytorch-backends.conf ./config/pytorch-backends.conf
COPY requirements ./requirements
COPY scripts/lib/compute.sh ./scripts/lib/compute.sh
COPY scripts/install-python-dependencies.sh ./scripts/install-python-dependencies.sh
RUN bash ./scripts/install-python-dependencies.sh \
      --backend "${PYTORCH_BACKEND}" requirements/dashboard.txt && \
    mkdir -p /root/.cache /tmp/ai-stack-dashboard

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', device='cpu')"

COPY scripts/dashboard/dashboard_api.py ./dashboard_api.py
COPY --from=frontend-build /frontend/dist ./frontend/dist
COPY src ./src
COPY config ./config
COPY config.yaml ./config.yaml

EXPOSE 9100

CMD ["uvicorn", "dashboard_api:app", "--host", "0.0.0.0", "--port", "9100"]
