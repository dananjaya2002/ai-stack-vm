FROM docker.io/library/python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends git gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/dashboard/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && \
    mkdir -p /root/.cache /tmp/ai-stack-dashboard

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY scripts/dashboard/dashboard_api.py ./dashboard_api.py
COPY scripts/dashboard/static ./static
COPY scripts/memory-proxy ./memory-proxy
COPY scripts/watcher ./watcher

EXPOSE 9100

CMD ["uvicorn", "dashboard_api:app", "--host", "0.0.0.0", "--port", "9100"]
