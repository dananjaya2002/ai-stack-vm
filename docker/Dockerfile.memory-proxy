# Dockerfile.memory-proxy
# Requires the base image to be built first:
#   docker build -f docker/Dockerfile.base -t ai-stack/base-deps .
# Then build this image:
#   docker build -f docker/Dockerfile.memory-proxy -t ai-stack/memory-proxy .
#
FROM ai-stack/base-deps
WORKDIR /app

# Copy memory-proxy source files only
COPY --chown=appuser:appuser scripts/memory-proxy/memory_api.py ./memory_api.py
COPY --chown=appuser:appuser scripts/memory-proxy/.example.memory-api.env ./.example.memory-api.env

EXPOSE 9002
CMD ["uvicorn", "memory_api:app", "--host", "0.0.0.0", "--port", "9002"]
