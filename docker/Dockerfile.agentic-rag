# Dockerfile.agentic-rag
# Requires the base image to be built first:
#   docker build -f docker/Dockerfile.base -t ai-stack/base-deps .
#
FROM ai-stack/base-deps
WORKDIR /app

ENV OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONUNBUFFERED=1

ENV PYTHONPATH=/app/src:/app

COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser config ./config
COPY --chown=appuser:appuser config.yaml ./config.yaml

# Seed the named volume with a directory writable by the non-root proxy user.
RUN mkdir -p /logs/agentic-rag && chown -R appuser:appuser /logs/agentic-rag

USER appuser
EXPOSE 9200

CMD ["uvicorn", "ai_stack_rag.api.agentic:app", "--host", "0.0.0.0", "--port", "9200", "--workers", "1"]
