# Dockerfile.code-proxy
# Requires the base image to be built first:
#   docker build -f docker/Dockerfile.base -t ai-stack/base-deps .
# Then build this image:
#   docker build -f docker/Dockerfile.code-proxy -t ai-stack/code-proxy .
#
FROM ai-stack/base-deps
WORKDIR /app

# CPU core thread throttling for high-core environments
ENV OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONUNBUFFERED=1

ENV PYTHONPATH=/app/src:/app

COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser config ./config
COPY --chown=appuser:appuser config.yaml ./config.yaml

# Seed the named volume with a directory writable by the non-root proxy user.
RUN mkdir -p /logs/code && chown -R appuser:appuser /logs/code

# Switch to the non-root execution user
USER appuser
# Expose your targeted service port
EXPOSE 9001

# Run with Uvicorn configured for performance
CMD ["uvicorn", "ai_stack_rag.api.code:app", "--host", "0.0.0.0", "--port", "9001", "--workers", "1"]
